{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "dh-briefing",
  "main": "src/server/index.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  // Produkcja ma jeden adres: własna domena w strefie designhouse.me. Bez workers.dev i podglądów wersji,
  // bo ciasteczko sesji, sprawdzanie Origin i linki w mailach zakładają jeden origin.
  "routes": [{ "pattern": "briefflow.designhouse.me", "custom_domain": true }],
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/agents/*"]
  },
  "durable_objects": {
    "bindings": [
      { "name": "BriefAgent", "class_name": "BriefAgent" },
      { "name": "Accounts", "class_name": "AccountStore" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["BriefAgent"] },
    { "tag": "v2", "new_sqlite_classes": ["AccountStore"] }
  ],
  // Zapasowy transport maili bez RESEND_API_KEY; wymaga domeny w Cloudflare Email Service.
  "send_email": [{ "name": "EMAIL" }],
  "vars": {
    "EMAIL_FROM": "briefflow@designhouse.me",
    // Kto może się zalogować: domeny po przecinku. Pusto = każdy adres.
    "ALLOWED_EMAIL_DOMAINS": ""
  },
  "observability": { "enabled": true }
}
